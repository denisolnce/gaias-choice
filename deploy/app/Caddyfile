# Caddy reads env placeholders natively. Automatic Let's Encrypt TLS for the
# subdomain the owner points at the VM — independent of the site's future
# custom domain (the SEO plan stays decoupled).
{$API_DOMAIN} {
	# Transport-level hardening (the backend owns per-field size caps + a 429
	# rate limiter already; these fill the gaps that belong at the edge):
	#   - HSTS: browsers refuse plaintext (Caddy already force-redirects to 443).
	#     No preload/includeSubDomains — don't bind sibling *.gardenofatlantis.com.
	#   - nosniff: no MIME-sniffing of our JSON responses.
	#   - -Server: drop the `Server: Caddy` version banner.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Cap the request body BEFORE gin buffers it into memory — the backend's
	# 256KB/1MB field caps only fire after the full body is read, so a giant POST
	# to the unauthenticated /track or /auth/* endpoints is a cheap OOM otherwise.
	# 10MB clears the base64 image-upload path (~1.4MB for a 1MB image) with room.
	request_body {
		max_size 10MB
	}

	# Edge-drop the constant bot scans (/.env, /.git, wp-*, *.php …) before they
	# ever reach the api — `abort` closes the TCP connection with no response, so
	# they cost nothing and stop cluttering the backend logs. This is NOT rate
	# limiting or IP banning: Caddy has no native counter keyed on response
	# status (that's the fail2ban pattern), and real rate limiting needs the
	# caddy-ratelimit plugin, i.e. a custom image off the stock caddy:2-alpine —
	# not worth it while these scans just 404 harmlessly. Add paths as new
	# scanner patterns show up in the logs. (Path matching is case-insensitive.)
	@scanners path /.env* /.git* /wp-* /wordpress* /vendor/* /.aws/* /.ssh/* /config* /phpinfo* *.php *.asp *.aspx
	handle @scanners {
		abort
	}

	handle {
		reverse_proxy api:8787
	}
}

# The village portal, on its own hostname. The A record `{$POTOK_DOMAIN}` → this
# VM was created by the village (2026-09-06). Automatic Let's Encrypt TLS, same
# as the site above; the cert lands in the same `/srv/gaias-choice/caddy` volume.
#
# The `potok-api` container now serves BOTH the JSON api and the portal's own
# frontend (static files embedded in the Go binary), so this host proxies
# EVERYTHING to it — no prefix strip, no `handle` split, no static root here.
{$POTOK_DOMAIN} {
	# Same edge hardening as the api site, same reasoning (see its comments):
	# HSTS with no preload/includeSubDomains, no MIME sniffing, no Server banner.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Same 10MB cap, same reason — stop a giant POST before the Go handler reads it.
	request_body {
		max_size 10MB
	}

	# Same bot-scan drop list as the api site MINUS `/config*` and `/vendor/*`:
	# this host serves an SPA, and both of those are plausible real paths on a
	# static frontend (a bundler's vendor chunk dir, a runtime config.json, a
	# `/config` route). The remaining patterns can never be legitimate here.
	# `abort` closes the connection with no response. Add patterns as new scans
	# show up in the logs. (Path matching is case-insensitive.)
	@scanners path /.env* /.git* /wp-* /wordpress* /.aws/* /.ssh/* /phpinfo* *.php *.asp *.aspx
	handle @scanners {
		abort
	}

	# No Content-Security-Policy here on purpose: the portal sets its own on
	# index.html (mokri-potok-portal, backend/internal/httpapi/static.go), so
	# the policy ships and is tested with the frontend it describes. Setting a
	# second one here would only intersect with it. (The api site above skips
	# CSP for a different reason: it serves JSON, never framed HTML.)
	reverse_proxy potok-api:8788
}

# The Porta Pagi landing page, on its own hostname (A record → this VM,
# owner, 2026-09-24). A static site served by its own container; that
# container sets the page's CSP, this block only the edge headers.
{$PAGI_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	@scanners path /.env* /.git* /wp-* /wordpress* /.aws/* /.ssh/* /phpinfo* *.php *.asp *.aspx
	handle @scanners {
		abort
	}
	# Who finds the page, without a tracker: the access log is the analytics,
	# read after the fact by porta-pagi-cloud's `task lens` (search and AI
	# crawlers, assistants fetching for a user, where people came from). The
	# page's promises list what a line holds, and a line holds only that: the
	# page asked for, the browser's User-Agent, the Referer, and the address
	# cut to /24 or /48 (a street, not a house). Every other header (a
	# language, a device hint), the TLS details and the response headers are
	# deleted before the write; User-Agent and Referer come back as two
	# top-level fields by log_append. 90 days, as the page says: the file
	# rolls daily, and a rolled file is deleted at 90 days (roll_keep_for
	# ages only rolled files, so without the daily roll a quiet live file
	# would keep its first lines for a year). The two Porta Pagi sites only —
	# the village and the api keep no access log.
	log {
		output file /var/log/caddy/pagi-site.log {
			roll_size 10MiB
			roll_interval 24h
			roll_keep 100
			roll_keep_for 90d
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>remote_port delete
			request>headers delete
			request>tls delete
			resp_headers delete
			wrap json
		}
	}
	log_append ua {http.request.header.User-Agent}
	log_append referer {http.request.header.Referer}
	# Assets, not pages: one line per visit is enough.
	@assets path /fonts/* /img/* /style.css /icon.svg
	log_skip @assets
	reverse_proxy pagi-site:8080
}

# The Porta Pagi demo village: the same shape as the village portal above
# (the same binary, the demo build), so the same edge rules — and the same
# 10MB body cap, which matters more here because anyone may upload.
{$PAGI_DEMO_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	request_body {
		max_size 10MB
	}
	@scanners path /.env* /.git* /wp-* /wordpress* /.aws/* /.ssh/* /phpinfo* *.php *.asp *.aspx
	handle @scanners {
		abort
	}
	# Same log as the landing above, same fields, same masking, same 90
	# days: page loads, and the one API call that says a visitor walked in
	# as a house (POST /api/demo/enter). Every other /api call is skipped —
	# which rooms a visitor opens is not "does anyone find us", which is
	# all the page says the log is for. Static files and pictures skipped.
	log {
		output file /var/log/caddy/pagi-demo.log {
			roll_size 10MiB
			roll_interval 24h
			roll_keep 100
			roll_keep_for 90d
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>remote_port delete
			request>headers delete
			request>tls delete
			resp_headers delete
			wrap json
		}
	}
	log_append ua {http.request.header.User-Agent}
	log_append referer {http.request.header.Referer}
	@quiet {
		path /assets/* /fonts/* *.png *.jpg *.svg /sw.js /manifest.webmanifest /changelog.json /api/*
		not path /api/demo/enter
	}
	log_skip @quiet
	reverse_proxy pagi-demo:8788
}

# Names that only redirect (2026-10-08): `www.` of the landing, and the two
# test addresses the landing and the demo had before portapagi.com — links
# to them were already sent, so they answer a 301 to the same path on the
# real name, not a dead host. Literal names on purpose: they are retired,
# not configuration. Each keeps its own Let's Encrypt cert, renewed while
# its A record points here.
www.{$PAGI_DOMAIN}, porta-pagi.gardenofatlantis.com {
	redir https://{$PAGI_DOMAIN}{uri} permanent
}
pp-demo.gardenofatlantis.com {
	redir https://{$PAGI_DEMO_DOMAIN}{uri} permanent
}
